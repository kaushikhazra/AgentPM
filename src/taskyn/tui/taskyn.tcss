/* Taskyn TUI Stylesheet
   Centralized styles following KISS and DRY principles.
   Uses Textual's default theme variables.
*/

/* ============================================================
   MODAL DIALOGS - Shared base styles
   ============================================================ */

/* All modal screens center their content */
ModalScreen {
    align: center middle;
}

/* Standard dialog container */
.modal-dialog {
    width: 60;
    height: auto;
    max-height: 85%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

/* Wider dialog for forms with more fields */
.modal-dialog-wide {
    width: 70;
    height: auto;
    max-height: 90%;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

/* Narrow dialog for confirmations */
.modal-dialog-narrow {
    width: 50;
    height: auto;
    border: thick $primary;
    background: $surface;
    padding: 1 2;
}

/* Dialog title */
.dialog-title {
    text-align: center;
    text-style: bold;
    padding-bottom: 1;
}

.dialog-title-warning {
    color: $warning;
}

.dialog-title-destructive {
    color: $error;
}

.dialog-message {
    text-align: center;
    padding: 1 0;
}

/* ============================================================
   BACKUP DIALOG
   ============================================================ */

#backup-list {
    height: auto;
    max-height: 15;
    padding: 1;
}

.backup-item {
    height: auto;
    padding: 1;
    margin-bottom: 1;
}

.backup-name {
    text-style: bold;
}

.backup-info {
    color: $text-muted;
}

/* ============================================================
   TAG PICKER
   ============================================================ */

#tag-list {
    height: auto;
    max-height: 20;
    padding: 1;
}

#create-tag-btn {
    margin-top: 1;
}

/* ============================================================
   STATUS PICKER
   ============================================================ */

#status-list {
    height: auto;
    max-height: 10;
}

/* ============================================================
   FORMS - Shared form styles
   ============================================================ */

.form-row {
    height: auto;
    margin-bottom: 1;
}

.form-label {
    width: 14;
    padding-top: 1;
}

.form-input {
    width: 1fr;
}

/* Form widgets take full width */
.form-input Input,
.form-input Select,
.form-input TextArea {
    width: 100%;
}

/* TextArea default height */
TextArea {
    height: 4;
}

/* Error text */
.error-text {
    color: $error;
    height: auto;
}

/* ============================================================
   BUTTONS
   ============================================================ */

.button-row {
    margin-top: 1;
    height: auto;
    align: center middle;
}

.button-row Button {
    margin: 0 1;
}

/* ============================================================
   CONFIRM DIALOG VARIANTS
   ============================================================ */

.modal-dialog-destructive {
    border: thick $error;
}

/* ============================================================
   DASHBOARD LAYOUT
   ============================================================ */

DashboardScreen {
    layout: grid;
    grid-size: 2 3;
    grid-columns: 1fr 3fr;
    grid-rows: 1fr auto auto;
    grid-gutter: 1;
}

#sidebar {
    row-span: 3;
    border: solid $primary;
    padding: 1;
}

#main-content {
    border: solid $secondary;
}

#bottom-panels {
    layout: horizontal;
}

#stats-panel {
    width: 1fr;
    border: solid $secondary;
    padding: 1;
}

#timer-panel {
    width: 1fr;
    border: solid $accent;
    padding: 1;
}

#activity-panel {
    border: solid $secondary;
    padding: 1;
    max-height: 10;
}

/* Narrow layout - hide sidebar */
DashboardScreen.-narrow {
    grid-size: 1 3;
    grid-columns: 1fr;
}

DashboardScreen.-narrow #sidebar {
    display: none;
}

/* Compact layout - smaller sidebar */
DashboardScreen.-compact #sidebar {
    width: 22;
}

/* ============================================================
   PROJECT TREE
   ============================================================ */

#project-tree {
    width: 100%;
    height: 100%;
}

/* ============================================================
   TASK TABLE
   ============================================================ */

TaskTable {
    height: 100%;
}

/* ============================================================
   PANELS & WIDGETS - Shared
   ============================================================ */

.panel-title {
    text-style: bold;
    padding-bottom: 1;
}

/* ============================================================
   SCREENS - Common background
   ============================================================ */

SettingsScreen,
StatisticsScreen,
ActivityScreen,
SearchScreen,
MilestoneDetailScreen,
ProjectDetailScreen,
CompanyDetailScreen,
KanbanScreen {
    background: $surface;
}

/* ============================================================
   SETTINGS SCREEN
   ============================================================ */

#settings-content {
    padding: 2;
}

.settings-section {
    margin-bottom: 2;
    padding: 1 2;
    border: solid $surface-lighten-1;
    background: $surface-darken-1;
}

.setting-row {
    height: auto;
    margin: 1 0;
}

.setting-label {
    width: 20;
    padding-top: 1;
}

.setting-value {
    width: 1fr;
}

.db-info {
    color: $text-muted;
    padding: 0 0 1 0;
}

.version-info {
    text-align: center;
    color: $text-muted;
    padding-top: 2;
}

/* ============================================================
   STATISTICS SCREEN
   ============================================================ */

#stats-header {
    height: auto;
    padding: 1 2;
    background: $surface-darken-1;
}

#stats-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#project-row {
    height: auto;
}

#project-select {
    width: 40;
}

#stats-content {
    padding: 1 2;
}

.stats-section {
    margin-bottom: 2;
    padding: 1 2;
    border: solid $surface-lighten-1;
    background: $surface-darken-1;
}

.blocker-item {
    padding: 0 1;
    color: $error;
}

.no-data {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

/* ============================================================
   ACTIVITY SCREEN
   ============================================================ */

#activity-header {
    height: auto;
    padding: 1 2;
    background: $surface-darken-1;
}

#activity-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#filter-row {
    height: auto;
}

.filter-label {
    width: auto;
    padding: 1 1 0 0;
}

.filter-select {
    width: 20;
    margin-right: 2;
}

#refresh-btn {
    dock: right;
}

#activity-content {
    padding: 1 2;
}

.activity-item {
    padding: 1;
    margin-bottom: 1;
    background: $surface-lighten-1;
    border-left: thick $primary;
}

.activity-item.created {
    border-left: thick $success;
}

.activity-item.deleted {
    border-left: thick $error;
}

.activity-item.status_changed {
    border-left: thick $warning;
}

.activity-header {
    text-style: bold;
}

.activity-detail {
    color: $text-muted;
}

.activity-time {
    color: $text-muted;
    text-align: right;
}

.no-activity {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

.pagination {
    height: auto;
    padding: 1;
    align: center middle;
}

.pagination Button {
    margin: 0 1;
}

.page-info {
    padding: 0 2;
}

/* ============================================================
   SEARCH SCREEN
   ============================================================ */

#search-header {
    height: auto;
    padding: 1 2;
    background: $surface-darken-1;
}

#search-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

#search-input-row {
    height: auto;
    margin-bottom: 1;
}

#search-input {
    width: 1fr;
    margin-bottom: 1;
}

#search-btn {
    margin-left: 1;
}

#search-content {
    padding: 1 2;
}

#search-results {
    height: 1fr;
    border: solid $secondary;
}

.result-item {
    padding: 1;
    margin-bottom: 1;
    background: $surface-lighten-1;
    border: solid $surface-lighten-2;
}

.result-item:hover {
    background: $surface-lighten-2;
}

.result-title {
    text-style: bold;
}

.result-type {
    color: $text-muted;
}

.result-meta {
    color: $text-muted;
    padding-top: 1;
}

.no-results {
    color: $text-muted;
    text-align: center;
    padding: 2;
}

.result-count {
    color: $text-muted;
    padding-bottom: 1;
}

/* ============================================================
   DETAIL SCREENS - Shared styles
   ============================================================ */

#milestone-detail-content,
#project-detail-content,
#company-detail-content {
    padding: 2;
}

.detail-screen {
    padding: 1 2;
}

.detail-header {
    text-style: bold;
    padding-bottom: 1;
    border-bottom: solid $secondary;
    margin-bottom: 1;
}

.detail-title {
    text-style: bold;
    padding-bottom: 1;
}

.detail-id {
    color: $text-muted;
}

.detail-section {
    margin-bottom: 1;
}

.detail-label {
    color: $text-muted;
}

.section-title,
.section-header {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

.section-header {
    padding-top: 1;
}

.milestone-item,
.task-item,
.project-item {
    padding: 0 2;
}

.project-item:hover {
    background: $surface-lighten-1;
}

.empty-message {
    color: $text-muted;
    padding: 0 2;
}

.meta-info {
    color: $text-muted;
    padding-top: 1;
}

.stat-row {
    height: auto;
    padding: 0 2;
}

.stat-label {
    width: 20;
}

.stat-value {
    text-style: bold;
    width: 1fr;
}

.progress-bar {
    padding: 1 0;
}

.milestone-row {
    padding: 0 1;
}

/* ============================================================
   KANBAN SCREEN
   ============================================================ */

#kanban-header {
    height: 3;
    padding: 1;
    background: $surface-darken-1;
    border-bottom: solid $surface-lighten-1;
}

#kanban-title {
    text-style: bold;
    color: $primary;
}

/* ============================================================
   KANBAN BOARD WIDGET
   ============================================================ */

KanbanBoard {
    width: 100%;
    height: 100%;
    padding: 1;
    layout: horizontal;
}

.kanban-column {
    width: 1fr;
    height: 100%;
    border: solid $secondary;
    margin: 0 1;
}

.kanban-column-header {
    text-style: bold;
    text-align: center;
    padding: 1;
    border-bottom: solid $secondary;
}

.kanban-column-content {
    height: 1fr;
    padding: 1;
}

/* ============================================================
   KANBAN COLUMN WIDGET
   ============================================================ */

KanbanColumn {
    width: 1fr;
    height: 100%;
    margin: 0 1;
    border: solid $surface-lighten-1;
    background: $surface-darken-1;
}

KanbanColumn .column-header {
    height: 3;
    padding: 1;
    text-align: center;
    text-style: bold;
    border-bottom: solid $surface-lighten-1;
}

KanbanColumn .column-count {
    text-align: center;
    color: $text-muted;
    padding-bottom: 1;
}

KanbanColumn .column-content {
    padding: 1;
}

KanbanColumn .empty-message {
    text-align: center;
    color: $text-muted;
    padding: 2;
}

/* ============================================================
   TASK CARD WIDGET
   ============================================================ */

TaskCard {
    height: auto;
    min-height: 3;
    max-height: 5;
    margin: 0 0 1 0;
    padding: 0 1;
    border: solid $surface-lighten-1;
    background: $surface;
}

TaskCard:focus {
    border: solid $accent;
    background: $surface-lighten-1;
}

TaskCard:hover {
    background: $surface-lighten-1;
}

TaskCard .card-title {
    width: 100%;
    text-style: bold;
}

TaskCard .card-meta {
    width: 100%;
    color: $text-muted;
}

TaskCard.done .card-title {
    text-style: strike;
    color: $text-muted;
}

/* ============================================================
   PROGRESS CHART WIDGET
   ============================================================ */

ProgressChart {
    height: auto;
    padding: 0 1;
}

ProgressChart .chart-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

ProgressChart .chart-row {
    height: auto;
}

ProgressChart .bar-label {
    width: 15;
}

ProgressChart .bar-container {
    width: 1fr;
}

/* ============================================================
   MILESTONE PROGRESS CHART WIDGET
   ============================================================ */

MilestoneProgressChart {
    height: auto;
    padding: 0 1;
}

MilestoneProgressChart .chart-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

MilestoneProgressChart .milestone-row {
    height: auto;
    padding: 0 1;
}

MilestoneProgressChart .overdue {
    color: $error;
}

/* ============================================================
   TAG LIST WIDGET
   ============================================================ */

TagList {
    height: auto;
    padding: 0 1;
    layout: horizontal;
}

TagList .tag-chip {
    height: auto;
    padding: 0 1;
    margin-right: 1;
    border: solid $primary;
    background: $surface-lighten-1;
}

TagList .tag-chip:hover {
    background: $surface-lighten-2;
}

TagList .tag-remove {
    margin-left: 1;
    width: 3;
    min-width: 3;
    height: 1;
    padding: 0;
}

TagList .add-tag-btn {
    margin-left: 1;
}

TagList .no-tags {
    color: $text-muted;
}

.tag-item {
    margin-right: 1;
}

/* ============================================================
   TIME ENTRY TABLE WIDGET
   ============================================================ */

TimeEntryTable {
    height: auto;
    max-height: 15;
    padding: 0 1;
}

TimeEntryTable .section-header {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

TimeEntryTable .total-row {
    text-style: bold;
    padding-top: 1;
}

TimeEntryTable .no-entries {
    color: $text-muted;
}

TimeEntryTable DataTable {
    height: auto;
    max-height: 10;
}

/* ============================================================
   EDGE LIST WIDGET
   ============================================================ */

EdgeList {
    height: auto;
    max-height: 10;
    padding: 0 1;
}

EdgeList .section-header {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

EdgeList .edge-item {
    height: auto;
    padding: 0 2;
}

EdgeList .edge-item:hover {
    background: $surface-lighten-1;
}

EdgeList .no-edges {
    color: $text-muted;
    padding: 0 2;
}

/* ============================================================
   TASK FORM WIDGET
   ============================================================ */

TaskForm {
    padding: 1 2;
    height: auto;
}

TaskForm .form-row {
    height: auto;
    margin-bottom: 1;
}

TaskForm .form-label {
    width: 12;
    padding-top: 1;
}

TaskForm .form-input {
    width: 1fr;
}

TaskForm Input {
    width: 100%;
}

TaskForm Select {
    width: 100%;
}

TaskForm TextArea {
    height: 6;
    width: 100%;
}

TaskForm .button-row {
    margin-top: 1;
    height: auto;
    align: center middle;
}

TaskForm Button {
    margin: 0 1;
}

TaskForm .error-text {
    color: $error;
    height: auto;
}

/* ============================================================
   ACTIVITY LOG WIDGET
   ============================================================ */

ActivityLog {
    height: auto;
    max-height: 12;
    padding: 1;
    border: solid $secondary;
}

ActivityLog .activity-title {
    text-style: bold;
    color: $accent;
    padding-bottom: 1;
}

ActivityLog #activity-list {
    height: auto;
    max-height: 8;
}

ActivityLog .activity-item {
    height: auto;
    padding: 0;
}

ActivityLog .activity-empty {
    color: $text-muted;
    text-align: center;
    padding: 1;
}

/* ============================================================
   TIMER DISPLAY WIDGET
   ============================================================ */

TimerDisplay {
    height: auto;
    padding: 1;
}

TimerDisplay #timer-digits {
    text-align: center;
    width: 100%;
    color: $accent;
}

TimerDisplay #timer-task-name {
    text-align: center;
    color: $text-muted;
    padding: 1 0;
}

TimerDisplay #timer-controls {
    align: center middle;
    height: auto;
    padding-top: 1;
}

TimerDisplay #timer-controls Button {
    margin: 0 1;
    min-width: 10;
}

TimerDisplay .recording-indicator {
    text-align: center;
    color: $error;
    text-style: bold;
}

TimerDisplay .paused-indicator {
    text-align: center;
    color: $warning;
}

TimerDisplay .idle-indicator {
    text-align: center;
    color: $text-muted;
}

.timer-display {
    text-align: center;
    text-style: bold;
}

.timer-task {
    text-align: center;
}

.recording {
    color: $error;
    text-style: bold;
}

/* ============================================================
   STATS PANEL WIDGET
   ============================================================ */

StatsPanel {
    height: auto;
    padding: 1;
}

StatsPanel .stats-title {
    text-style: bold;
    color: $primary;
    padding-bottom: 1;
}

StatsPanel .stats-row {
    height: auto;
    padding: 0 0 1 0;
}

StatsPanel .progress-bar-container {
    height: 1;
    padding: 1 0;
}

StatsPanel .priority-stats {
    height: auto;
}

StatsPanel .high-priority {
    color: #F43F5E;
}

StatsPanel .med-priority {
    color: #F59E0B;
}

StatsPanel .low-priority {
    color: #94A3B8;
}

/* ============================================================
   LOADING INDICATOR WIDGET
   ============================================================ */

LoadingOverlay {
    width: 100%;
    height: 100%;
    align: center middle;
    background: $surface 80%;
    layer: loading;
}

LoadingOverlay .loading-box {
    width: auto;
    height: auto;
    padding: 2 4;
    background: $surface;
    border: solid $primary;
}

LoadingOverlay .loading-message {
    text-align: center;
    color: $text-muted;
    padding-top: 1;
}

.loading-container {
    width: 100%;
    height: 100%;
    align: center middle;
}

.loading-text {
    padding-top: 1;
}

/* ============================================================
   EMPTY STATES
   ============================================================ */

EmptyState {
    width: 100%;
    height: 100%;
    align: center middle;
}

EmptyState .empty-icon {
    text-align: center;
    color: $text-muted;
}

EmptyState .empty-message {
    text-align: center;
    color: $text-muted;
    padding-top: 1;
}

EmptyState .empty-hint {
    text-align: center;
    color: $text-muted;
    padding-top: 1;
}

.empty-state {
    width: 100%;
    height: 100%;
    align: center middle;
}

.empty-state-message {
    text-align: center;
    padding-top: 1;
}
