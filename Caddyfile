# =============================================================================
# Taskyn Caddy Configuration
# Reverse proxy with automatic TLS
# =============================================================================

{$DOMAIN:localhost}:8030 {
    # Reverse proxy to Taskyn MCP server
    reverse_proxy taskyn:8020

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        -Server
    }

    # Logging
    log {
        output stdout
        format console
    }
}
