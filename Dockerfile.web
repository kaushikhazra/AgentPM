# Dockerfile for Taskyn Web Backend + Frontend
# Serves the FastAPI backend and static frontend assets

FROM python:3.12-slim AS backend

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY pyproject.toml README.md ./
COPY src/ ./src/

# Install the package with web extras (not editable - this is production)
RUN pip install --no-cache-dir ".[web]"


# Stage 2: Build frontend
FROM node:20-slim AS frontend

WORKDIR /app/frontend

# Copy frontend files
COPY src/taskyn/web/frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy source and build
COPY src/taskyn/web/frontend/ ./
RUN npm run build


# Stage 3: Final image
FROM backend AS final

# Copy built frontend assets to the installed package location
# (pip install puts files in site-packages, not /app/src)
COPY --from=frontend /app/frontend/dist /usr/local/lib/python3.12/site-packages/taskyn/web/frontend/dist

# Environment variables
ENV TASKYN_MCP_URL=http://mcp:8000/mcp
ENV TASKYN_JWT_SECRET=change-me-in-production
ENV TASKYN_CORS_ORIGINS=http://localhost:3000

# Expose web server port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# Run uvicorn
CMD ["uvicorn", "taskyn.web.backend.main:app", "--host", "0.0.0.0", "--port", "3000"]
