# Dockerfile for Taskyn MCP Server
# Serves the MCP API over HTTP (streamable-http transport)

FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY pyproject.toml README.md ./
COPY src/ ./src/

# Install the package (not editable - this is production)
RUN pip install --no-cache-dir .

# Create data directory for database
RUN mkdir -p /data

# Environment variables with defaults
ENV TASKYN_DB=/data/taskyn.db
ENV TASKYN_MCP_HOST=0.0.0.0
ENV TASKYN_MCP_PORT=8020

# Expose MCP server port
EXPOSE 8020

# Health check - verify MCP server is listening on port
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import socket; s=socket.socket(); s.settimeout(5); s.connect(('localhost',8020)); s.close()" || exit 1

# Run MCP server with streamable-http transport
CMD ["python", "-m", "taskyn.mcp", "--transport", "streamable-http"]
